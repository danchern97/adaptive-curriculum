#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --time=20:00:00
#SBATCH --cpus-per-task=9
#SBATCH --job-name=sf-gen-grpo-easy
#SBATCH --output=slurm_outputs/gen_grpo_easy_%j.out

source ~/.bashrc
module purge
module load 2024
module load Anaconda3/2024.06-1
source activate searchformer

cd /gpfs/home2/overven/adaptive-curriculum/searchformer-main

export LOCAL_DATA_PATH=local_data

# Generate 1000 samples with automatic 90/10 train/test split
# This will create ~900 training puzzles and ~100 test puzzles
# All guaranteed to be unique and non-overlapping
python -m searchformer.sokoban generate \
  --width 7 \
  --height 7 \
  --num-walls 2 \
  --num-boxes 2 \
  --num-samples 1100 \
  --dataset-suffix "-grpo-easy-1k"

echo "EASY generation completed, starting tokenization..."

# Tokenize the EASY dataset (single-threaded to avoid conflicts)
python -m searchformer.sokoban tokenize \
  --width 7 \
  --height 7 \
  --num-walls 2 \
  --num-boxes 2 \
  --dataset-suffix "-grpo-easy-1k"