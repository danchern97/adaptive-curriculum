#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --time=02:00:00
#SBATCH --cpus-per-task=8
#SBATCH --job-name=sf-gen-harder
#SBATCH --output=slurm_outputs/gen_harder_%j.out

source ~/.bashrc
conda activate searchformer

cd /gpfs/home2/overven/adaptive-curriculum/searchformer-main

# Set environment variable to use local_data instead of data
export LOCAL_DATA_PATH=local_data

# Run 4 parallel generation workers, each generating 25 samples (total 100)
# All samples will be test-only (no train/test split)
for i in {0..3}; do
    python -m searchformer.sokoban generate \
      --width 8 \
      --height 8 \
      --num-walls 3 \
      --num-boxes 3 \
      --num-samples 25 \
      --test-only &
done

# Wait for all generation workers to complete
wait

# Run tokenization with 4 parallel workers
for rank in {0..3}; do
    python -m searchformer.sokoban tokenize \
      --width 8 \
      --height 8 \
      --num-walls 3 \
      --num-boxes 3 \
      --rank $rank \
      --world-size 4 &
done

# Wait for all tokenization workers to complete
wait