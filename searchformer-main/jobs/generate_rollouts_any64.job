#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --time=04:00:00
#SBATCH --cpus-per-task=8
#SBATCH --job-name=rollout-any64
#SBATCH --output=slurm_outputs/rollout_any64_%j.out

source ~/.bashrc
conda activate searchformer

cd /gpfs/home2/overven/adaptive-curriculum/searchformer-main

# Set environment for local storage
export LOCAL_DATA_PATH=local_data

# Generate 64 rollouts (samples) per test puzzle
# This uses the ORIGINAL searchformer rollout system
python -m searchformer.rollout greedy \
  --checkpoint-id sokoban-7-by-7-walls-2-boxes-2-with-box-40k-14888123 \
  --dataset-name sokoban.7-by-7-walls-2-boxes-2.with-box-40k \
  --rollout-len 512 \
  --rollout-repeats 64 \
  --test-sequences 200 \
  --rank 0 \
  --world-size 1 \
  --batch-size 4

echo "Rollout generation complete!"
