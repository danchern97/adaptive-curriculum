#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --job-name=check-overlap
#SBATCH --output=slurm_outputs/check_overlap_%j.out

source ~/.bashrc
module purge
module load 2024
module load Anaconda3/2024.06-1
source activate searchformer

cd /gpfs/home2/overven/adaptive-curriculum/searchformer-main

echo "Starting dataset overlap check..."
echo "Job ID: $SLURM_JOB_ID"
echo "Running on: $(hostname)"
echo "Memory allocated: 32GB"
echo "CPUs: 4"
echo "Working directory: $(pwd)"
echo ""

# Run the overlap checker (in searchformer-main directory)
python ../check_dataset_overlap.py

echo ""
echo "Overlap check completed!"
echo "Job finished at: $(date)"