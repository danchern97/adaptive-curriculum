#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --time=20:00:00
#SBATCH --cpus-per-task=9
#SBATCH --job-name=sf-gen-grpo-hard
#SBATCH --output=slurm_outputs/gen_grpo_hard_%j.out

source ~/.bashrc
module purge
module load 2024
module load Anaconda3/2024.06-1
source activate searchformer

cd /gpfs/home2/overven/adaptive-curriculum/searchformer-main

export LOCAL_DATA_PATH=local_data

# Generate 1000 samples with automatic 90/10 train/test split
# 8x8 grids are larger than the 7x7 pretraining data = guaranteed different
python -m searchformer.sokoban generate \
  --width 8 \
  --height 8 \
  --num-walls 2 \
  --num-boxes 2 \
  --num-samples 1100 \
  --dataset-suffix "-grpo-hard-1k"

echo "HARD generation completed, starting tokenization..."

# Tokenize the HARD dataset (single-threaded to avoid conflicts)
python -m searchformer.sokoban tokenize \
  --width 8 \
  --height 8 \
  --num-walls 2 \
  --num-boxes 2 \
  --dataset-suffix "-grpo-hard-1k"