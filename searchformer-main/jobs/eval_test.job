# Evaluate on GRPO-hard (8x8 - larger puzzles than training)
echo ">>> Evaluating on GRPO-hard test set (8x8)..."
python -m searchformer.rollout greedy\
  --checkpoint-id "$CHECKPOINT_ID" \
  --dataset-name "sokoban.8-by-8-walls-2-boxes-2-grpo-hard.with-box-40k" \
  --rollout-len 20000 \
  --rollout-repeats 10 \
  --test-sequences 1 \
  --batch-size 1 \

echo ""
echo ">>> GRPO-hard evaluation complete!"
echo ""
echo "========================================================================"
echo "Evaluation finished!"
echo "========================================================================"
echo ""
echo "To analyze results, run:"
echo "  python compute_any_optimal_64.py --rollout-id <ROLLOUT_ID>"
